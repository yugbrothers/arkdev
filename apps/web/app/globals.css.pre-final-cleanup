@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #0f172a;
}

.dark {
  --background: #020617;
  --foreground: #f8fafc;
}

html,
body {
  min-height: 100%;
}

body {
  background: var(--background);
  color: var(--foreground);
  transition: all .3s ease;
  font-family: Arial, Helvetica, sans-serif;
}

.gradient-bg {
  background:
  radial-gradient(circle at top left,#2563eb 0%,transparent 30%),
  radial-gradient(circle at top right,#7c3aed 0%,transparent 30%),
  #020617;
}

html.light {
  --background: #ffffff;
  --foreground: #111111;
}

html.dark {
  --background: #000000;
  --foreground: #ffffff;
}

html.brand {
  --background: #050816;
  --foreground: #ffffff;
}

html.brand body {
  background:
    radial-gradient(
      circle at top left,
      rgba(59,130,246,.25),
      transparent 40%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(147,51,234,.25),
      transparent 40%
    ),
    #050816;
}

html.dark body {
  background: #000000;
}

html.light body {
  background: #ffffff;
}

