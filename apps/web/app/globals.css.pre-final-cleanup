      translateX(14px)
      rotate(-360deg);
  }
}

.orbit {
  animation: orbit 4s linear infinite;
}

@keyframes orbit {
  from {
    transform: rotate(0deg)
      translateX(14px)
      rotate(0deg);
  }

  to {
    transform: rotate(360deg)
      translateX(14px)
      rotate(-360deg);
  }
