.orbit {
  animation: orbit 4s linear infinite;
}

@keyframes orbRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.orb-spin {
  animation: orbRotate 10s linear infinite;
}

.glass-nav {
  backdrop-filter: blur(20px);
}

.video-overlay {
  background:
    linear-gradient(
      rgba(0,0,0,.45),
      rgba(0,0,0,.65)
    );
}

html.light body {
  background: #ffffff;
  color: #111111;
}

html.dark body {
  background: #000000;
  color: #ffffff;
}

html.brand body {
  background:
    radial-gradient(circle at top left,
    rgba(59,130,246,.25),
    transparent 35%),
    radial-gradient(circle at bottom right,
    rgba(168,85,247,.25),
    transparent 35%),
    #050816;
  color: white;
}

@keyframes orbRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.orb-spin {
  animation: orbRotate 8s linear infinite;
}

.ark-logo{
  animation:
  glow 3s infinite;
}

@keyframes glow{
  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-4px);
  }

  100%{
    transform:translateY(0px);
  }
}

.mascot{
  font-size:34px;
  animation:
  bounce 2s infinite;
}

@keyframes bounce{
  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-8px);
  }

  100%{
    transform:translateY(0px);
  }
}

.ark-logo{
  background:
  linear-gradient(
    90deg,
    #60a5fa,
    #a855f7,
    #ec4899
  );

  -webkit-background-clip:text;
  color:transparent;

  animation:
  arkGlow 4s linear infinite;
}

.ark-logo:hover{
  transform:scale(1.08);
}

@keyframes arkGlow{
  0%{
    filter:hue-rotate(0deg);
  }

  100%{
    filter:hue-rotate(360deg);
  }
}

nav a{
  transition:all .3s;
}

nav a:hover{
  transform:translateY(-2px);
}

.orb-spin{
  background:
  radial-gradient(
    circle,
    #3b82f6,
    #8b5cf6,
    transparent
  );

  animation:
  orbRotate 20s linear infinite;
}

@keyframes orbRotate{
  from{
    transform:
    translate(-50%,-50%)
    rotate(0deg);
  }

  to{
    transform:
    translate(-50%,-50%)
    rotate(360deg);
  }
}

.ark-gradient-text{
  background:
  linear-gradient(
    90deg,
    #ffffff,
    #a855f7,
    #3b82f6
  );

  -webkit-background-clip:text;
  color:transparent;
}

.ark-hover-card{
  transition:all .5s ease;
}

.ark-hover-card:hover{
  transform:
  translateY(-10px)
  scale(1.03);
}

.ark-navbar-link{
  position:relative;
}

.ark-navbar-link::after{
  content:"";
  position:absolute;
  left:0;
  bottom:-6px;
  width:0;
  height:2px;
  background:white;
  transition:.3s;
}

.ark-navbar-link:hover::after{
  width:100%;
}

.ark-brand{
  transition:.5s;
}

.ark-brand:hover{
  transform:translateY(-4px);
}

.nav-home:hover{
  transform:translateY(-4px);
}

.nav-about:hover{
  transform:rotate(-4deg);
}

.nav-blog:hover{
  transform:scale(1.08);
}

.nav-archive:hover{
  letter-spacing:.15em;
}

.nav-community:hover{
  transform:translateX(5px);
}

.nav-projects:hover{
  transform:translateY(-4px) scale(1.05);
}

.nav-ai:hover{
  filter:blur(.4px);
}

.nav-group{
  position:relative;
  cursor:pointer;
  padding-bottom:24px;
}

.nav-dropdown{
  position:absolute;
  top:100%;
  left:0;

  min-width:220px;

  opacity:0;
  visibility:hidden;
  transform:translateY(10px);
  transition:all .25s ease;

  padding:16px;

  border-radius:20px;

  backdrop-filter:blur(20px);

  background:rgba(0,0,0,.8);

  border:1px solid rgba(255,255,255,.08);
}

.nav-dropdown a{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
  padding:10px 0;
}

.nav-group:hover .nav-dropdown{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
}

/* PRIMARY 1104 OVERRIDE */

.nav-dropdown a{
  display:block;
  padding:10px 0;
  opacity:unset;
  visibility:unset;
  transform:none;
}

/* PRIMARY 1150 */

nav{
  display:flex;
  align-items:center;
}

nav a,
.nav-group{
  height:40px;
  display:flex;
  align-items:center;
}

.nav-group span{
  display:flex;
  align-items:center;
  height:40px;
}

.mascot-music{
  animation:
  mascotFloat 3s ease-in-out infinite;
}

@keyframes mascotFloat{

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-10px);
  }

  100%{
    transform:translateY(0px);
  }
}

.mascot-alert-success{
  box-shadow:
  0 0 60px #22c55e;
}

.mascot-alert-error{
  box-shadow:
  0 0 60px #ef4444;
}

.mascot-alert-info{
  box-shadow:
  0 0 60px #3b82f6;
}

.mascot-alert-warning{
  box-shadow:
  0 0 60px #f59e0b;
}

@keyframes mascotFloat {

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-10px);
  }

  100%{
    transform:translateY(0px);
  }

}

.mascot-float{
  animation:
  mascotFloat 4s ease-in-out infinite;
}


@keyframes mascotGlow {

  0%{
    filter:
    drop-shadow(0 0 5px #60a5fa);
  }

  50%{
    filter:
    drop-shadow(0 0 25px #60a5fa);
  }

  100%{
    filter:
    drop-shadow(0 0 5px #60a5fa);
  }

}

.mascot-glow{
  animation:
  mascotGlow 3s infinite;
}


@keyframes orbPulse {

  0%{
    transform:scale(1);
    opacity:.6;
  }

  50%{
    transform:scale(1.2);
    opacity:1;
  }

  100%{
    transform:scale(1);
    opacity:.6;
  }

}

.mascot-orb{

  position:absolute;

  inset:-10px;

  border-radius:9999px;

  border:2px solid
  rgba(96,165,250,.5);

}

.ring3{
  width:150px;
  height:150px;
  animation:rotateRing 14s linear infinite;
}

@keyframes rotateRing{
  from{transform:rotate(0deg);}
  to{transform:rotate(360deg);}
}

@keyframes rotateRingReverse{
  from{transform:rotate(360deg);}
  to{transform:rotate(0deg);}
}

@keyframes arkFloat{
  0%{transform:translateY(0);}
  50%{transform:translateY(-12px);}
  100%{transform:translateY(0);}
}

.ark-particle{
position:absolute;
width:6px;
height:6px;
border-radius:999px;
background:#60a5fa;
box-shadow:0 0 12px #60a5fa;
animation:particleFloat 6s infinite;
}

.p1{top:-15px;left:50%;}
.p2{top:50%;left:-15px;}
.p3{top:50%;right:-15px;}
.p4{bottom:-15px;left:30%;}
.p5{bottom:-10px;right:30%;}

@keyframes particleFloat{
0%{transform:translateY(0);}
50%{transform:translateY(-12px);}
100%{transform:translateY(0);}
}

.ark-ai-core:hover{

transform:scale(1.08);

transition:.4s;

filter:
drop-shadow(
0 0 30px
rgba(96,165,250,.9)
);

}

.ark-ai-core{

  position:relative;

  width:120px;
  height:120px;

  display:flex;
  align-items:center;
  justify-content:center;

  animation:
  arkFloat 6s ease-in-out infinite;

}

.ark-center{

  width:42px;
  height:42px;

  border-radius:999px;

  background:
  radial-gradient(
    circle,
    #60a5fa,
    #2563eb,
    #1e3a8a
  );

  box-shadow:
  0 0 20px #60a5fa,
  0 0 50px #2563eb,
  0 0 80px #1e40af;

}

.ark-ring{

  position:absolute;

  border-radius:999px;

  border:
  2px solid rgba(96,165,250,.4);

}

.ring1{
  width:60px;
  height:60px;
  animation:spin 8s linear infinite;
}

.ring2{
  width:90px;
  height:90px;
  animation:spinReverse 12s linear infinite;
}

.ring3{
  width:120px;
  height:120px;
  animation:spin 18s linear infinite;
}

@keyframes spin{
  from{transform:rotate(0deg);}
  to{transform:rotate(360deg);}
}

@keyframes spinReverse{
  from{transform:rotate(360deg);}
  to{transform:rotate(0deg);}
}

@keyframes arkFloat{
  0%{transform:translateY(0);}
  50%{transform:translateY(-12px);}
  100%{transform:translateY(0);}
}

