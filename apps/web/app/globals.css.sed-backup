@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #0f172a;
}

.dark {
  --background: #020617;
  --foreground: #f8fafc;
}

html,
body {
  min-height: 100%;
}

body {
  background: var(--background);
  color: var(--foreground);
  transition: all .3s ease;
  font-family: Arial, Helvetica, sans-serif;
}

.gradient-bg {
  background:
  radial-gradient(circle at top left,#2563eb 0%,transparent 30%),
  radial-gradient(circle at top right,#7c3aed 0%,transparent 30%),
  #020617;
}

html.light {
  --background: #ffffff;
  --foreground: #111111;
}

html.dark {
  --background: #000000;
  --foreground: #ffffff;
}

html.brand {
  --background: #050816;
  --foreground: #ffffff;
}

html.brand body {
  background:
    radial-gradient(
      circle at top left,
      rgba(59,130,246,.25),
      transparent 40%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(147,51,234,.25),
      transparent 40%
    ),
    #050816;
}

html.dark body {
  background: #000000;
}

html.light body {
  background: #ffffff;
}

@keyframes orbit {
  from {
    transform: rotate(0deg)
      translateX(14px)
      rotate(0deg);
  }

  to {
    transform: rotate(360deg)
      translateX(14px)
      rotate(-360deg);
  }
}

.orbit {
  animation: orbit 4s linear infinite;
}

@keyframes orbit {
  from {
    transform: rotate(0deg)
      translateX(14px)
      rotate(0deg);
  }

  to {
    transform: rotate(360deg)
      translateX(14px)
      rotate(-360deg);
  }
}

.orbit {
  animation: orbit 4s linear infinite;
}

@keyframes orbRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.orb-spin {
  animation: orbRotate 10s linear infinite;
}

.glass-nav {
  backdrop-filter: blur(20px);
}

.video-overlay {
  background:
    linear-gradient(
      rgba(0,0,0,.45),
      rgba(0,0,0,.65)
    );
}

html.light body {
  background: #ffffff;
  color: #111111;
}

html.dark body {
  background: #000000;
  color: #ffffff;
}

html.brand body {
  background:
    radial-gradient(circle at top left,
    rgba(59,130,246,.25),
    transparent 35%),
    radial-gradient(circle at bottom right,
    rgba(168,85,247,.25),
    transparent 35%),
    #050816;
  color: white;
}

@keyframes orbRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.orb-spin {
  animation: orbRotate 8s linear infinite;
}

.ark-logo{
  animation:
  glow 3s infinite;
}

@keyframes glow{
  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-4px);
  }

  100%{
    transform:translateY(0px);
  }
}

.mascot{
  font-size:34px;
  animation:
  bounce 2s infinite;
}

@keyframes bounce{
  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-8px);
  }

  100%{
    transform:translateY(0px);
  }
}

.ark-logo{
  background:
  linear-gradient(
    90deg,
    #60a5fa,
    #a855f7,
    #ec4899
  );

  -webkit-background-clip:text;
  color:transparent;

  animation:
  arkGlow 4s linear infinite;
}

.ark-logo:hover{
  transform:scale(1.08);
}

@keyframes arkGlow{
  0%{
    filter:hue-rotate(0deg);
  }

  100%{
    filter:hue-rotate(360deg);
  }
}

nav a{
  transition:all .3s;
}

nav a:hover{
  transform:translateY(-2px);
}

.orb-spin{
  background:
  radial-gradient(
    circle,
    #3b82f6,
    #8b5cf6,
    transparent
  );

  animation:
  orbRotate 20s linear infinite;
}

@keyframes orbRotate{
  from{
    transform:
    translate(-50%,-50%)
    rotate(0deg);
  }

  to{
    transform:
    translate(-50%,-50%)
    rotate(360deg);
  }
}

.ark-gradient-text{
  background:
  linear-gradient(
    90deg,
    #ffffff,
    #a855f7,
    #3b82f6
  );

  -webkit-background-clip:text;
  color:transparent;
}

.ark-hover-card{
  transition:all .5s ease;
}

.ark-hover-card:hover{
  transform:
  translateY(-10px)
  scale(1.03);
}

.ark-navbar-link{
  position:relative;
}

.ark-navbar-link::after{
  content:"";
  position:absolute;
  left:0;
  bottom:-6px;
  width:0;
  height:2px;
  background:white;
  transition:.3s;
}

.ark-navbar-link:hover::after{
  width:100%;
}

.ark-brand{
  transition:.5s;
}

.ark-brand:hover{
  transform:translateY(-4px);
}

.ark-core{
  width:56px;
  height:56px;
  border-radius:999px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  font-weight:900;
  background:white;
  color:black;
  animation:arkSpin 8s linear infinite;
}

.ark-title{
  font-size:30px;
  font-weight:900;
  letter-spacing:.15em;
}

.ark-subtitle{
  font-size:11px;
  opacity:.6;
}

@keyframes arkSpin{
  from{
    transform:rotate(0deg);
  }

  to{
    transform:rotate(360deg);
  }
}

.mascot-btn{
  width:54px;
  height:54px;
  border-radius:999px;
  font-size:28px;
  animation:floatMascot 2s ease-in-out infinite;
}

@keyframes floatMascot{
  0%{
    transform:translateY(0);
  }

  50%{
    transform:translateY(-6px);
  }

  100%{
    transform:translateY(0);
  }
}

.nav-home:hover{
  transform:translateY(-4px);
}

.nav-about:hover{
  transform:rotate(-4deg);
}

.nav-blog:hover{
  transform:scale(1.08);
}

.nav-archive:hover{
  letter-spacing:.15em;
}

.nav-community:hover{
  transform:translateX(5px);
}

.nav-projects:hover{
  transform:translateY(-4px) scale(1.05);
}

.nav-ai:hover{
  filter:blur(.4px);
}

.nav-group{
  position:relative;
  cursor:pointer;
  padding-bottom:24px;
}

.nav-dropdown{
  position:absolute;
  top:100%;
  left:0;

  min-width:220px;

  opacity:0;
  visibility:hidden;
  transform:translateY(10px);
  transition:all .25s ease;

  padding:16px;

  border-radius:20px;

  backdrop-filter:blur(20px);

  background:rgba(0,0,0,.8);

  border:1px solid rgba(255,255,255,.08);
}

.nav-dropdown a{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
  padding:10px 0;
}

.nav-group:hover .nav-dropdown{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
}

/* PRIMARY 1104 OVERRIDE */

.nav-dropdown a{
  display:block;
  padding:10px 0;
  opacity:unset;
  visibility:unset;
  transform:none;
}

/* PRIMARY 1150 */

nav{
  display:flex;
  align-items:center;
}

nav a,
.nav-group{
  height:40px;
  display:flex;
  align-items:center;
}

.nav-group span{
  display:flex;
  align-items:center;
  height:40px;
}

.mascot-music{
  animation:
  mascotFloat 3s ease-in-out infinite;
}

@keyframes mascotFloat{

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-10px);
  }

  100%{
    transform:translateY(0px);
  }
}

.mascot-alert-success{
  box-shadow:
  0 0 60px #22c55e;
}

.mascot-alert-error{
  box-shadow:
  0 0 60px #ef4444;
}

.mascot-alert-info{
  box-shadow:
  0 0 60px #3b82f6;
}

.mascot-alert-warning{
  box-shadow:
  0 0 60px #f59e0b;
}

@keyframes mascotFloat {

  0%{
    transform:translateY(0px);
  }

  50%{
    transform:translateY(-10px);
  }

  100%{
    transform:translateY(0px);
  }

}

.mascot-float{
  animation:
  mascotFloat 4s ease-in-out infinite;
}


@keyframes mascotGlow {

  0%{
    filter:
    drop-shadow(0 0 5px #60a5fa);
  }

  50%{
    filter:
    drop-shadow(0 0 25px #60a5fa);
  }

  100%{
    filter:
    drop-shadow(0 0 5px #60a5fa);
  }

}

.mascot-glow{
  animation:
  mascotGlow 3s infinite;
}


@keyframes orbPulse {

  0%{
    transform:scale(1);
    opacity:.6;
  }

  50%{
    transform:scale(1.2);
    opacity:1;
  }

  100%{
    transform:scale(1);
    opacity:.6;
  }

}

.mascot-orb{

  position:absolute;

  inset:-10px;

  border-radius:9999px;

  border:2px solid
  rgba(96,165,250,.5);

  animation:
  orbPulse 2s infinite;

}

.ark-core{

  position:relative;

  width:90px;
  height:90px;

  display:flex;
  align-items:center;
  justify-content:center;

  animation:
    arkFloat 6s ease-in-out infinite;
}

.ark-center{

  width:40px;
  height:40px;

  border-radius:9999px;

  background:
    radial-gradient(
      circle,
      #ffffff,
      #60a5fa,
      #7c3aed
    );

  box-shadow:
    0 0 30px #60a5fa,
    0 0 60px #7c3aed;

}

.ark-ring{

  position:absolute;

  border-radius:9999px;

  border:
    2px solid rgba(255,255,255,.25);

}

.ring1{

  width:90px;
  height:90px;

  animation:
    rotateRing 8s linear infinite;
}

.ring2{

  width:70px;
  height:70px;

  animation:
    rotateRingReverse 6s linear infinite;
}

.ring3{

  width:110px;
  height:110px;

  animation:
    rotateRing 10s linear infinite;
}

@keyframes rotateRing{

  from{
    transform:rotate(0deg);
  }

  to{
    transform:rotate(360deg);
  }

}

@keyframes rotateRingReverse{

  from{
    transform:rotate(360deg);
  }

  to{
    transform:rotate(0deg);
  }

}

@keyframes arkFloat{

  0%{
    transform:
      translateY(0px);
  }

  50%{
    transform:
      translateY(-12px);
  }

  100%{
    transform:
      translateY(0px);
  }

}


.ark-core{
  position:relative;
  width:120px;
  height:120px;
  display:flex;
  align-items:center;
  justify-content:center;
  animation:arkFloat 6s ease-in-out infinite;
}

.ark-video{
  width:90px;
  height:90px;
  border-radius:9999px;
  object-fit:cover;
  box-shadow:
    0 0 30px #60a5fa,
    0 0 80px #7c3aed;
}

.ark-ring{
  position:absolute;
  border-radius:9999px;
  border:2px solid rgba(255,255,255,.2);
}

.ring1{
  width:110px;
  height:110px;
  animation:rotateRing 8s linear infinite;
}

.ring2{
  width:130px;
  height:130px;
  animation:rotateRingReverse 10s linear infinite;
}

.ring3{
  width:150px;
  height:150px;
  animation:rotateRing 14s linear infinite;
}

@keyframes rotateRing{
  from{transform:rotate(0deg);}
  to{transform:rotate(360deg);}
}

@keyframes rotateRingReverse{
  from{transform:rotate(360deg);}
  to{transform:rotate(0deg);}
}

@keyframes arkFloat{
  0%{transform:translateY(0);}
  50%{transform:translateY(-15px);}
  100%{transform:translateY(0);}
}


.ark-ai-core{

position:relative;

width:90px;
height:90px;

display:flex;
align-items:center;
justify-content:center;

animation:
arkFloat 6s ease-in-out infinite;

}

.ark-center{

width:42px;
height:42px;

border-radius:999px;

background:
radial-gradient(
circle,
#60a5fa,
#2563eb,
#1e3a8a
);

box-shadow:
0 0 20px #60a5fa,
0 0 50px #2563eb,
0 0 80px #1e40af;

animation:
arkPulse 3s infinite;

}

.ark-ring{

position:absolute;

border-radius:999px;

border:
2px solid rgba(96,165,250,.4);

}

.ring1{

width:60px;
height:60px;

animation:
spin 8s linear infinite;

}

.ring2{

width:80px;
height:80px;

animation:
spinReverse 12s linear infinite;

}

.ring3{

width:100px;
height:100px;

animation:
spin 18s linear infinite;

}

@keyframes spin{

from{
transform:rotate(0deg);
}

to{
transform:rotate(360deg);
}

}

@keyframes spinReverse{

from{
transform:rotate(360deg);
}

to{
transform:rotate(0deg);
}

}

@keyframes arkFloat{

0%{
transform:translateY(0px);
}

50%{
transform:translateY(-12px);
}

100%{
transform:translateY(0px);
}

}

@keyframes arkPulse{

0%{
transform:scale(1);
}

50%{
transform:scale(1.12);
}

100%{
transform:scale(1);
}

}
